SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false

# Gmail enquiry delivery (optional)
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_RECEIVER=receiver@example.com

# Local Excel enquiry register
ENQUIRY_EXCEL_FILE=Portfolio_Enquiries.xlsx

# Google Sheets enquiry register (optional)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_NAME=Enquiries
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# Production/Vercel alternative: base64-encoded service-account JSON
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# OpenAI real-time chatbot (optional but required for real AI replies)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# WhatsApp: country code + number, digits only
WHATSAPP_NUMBER=919999999999
